{
  "name": "slop-sheriff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "imports": {
    "#*": "./agent/*",
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "eve build --skip-sandbox-prewarm",
    "check": "bun run typecheck && bun test && bun run test:e2e:mock && bun run eve:info && bun run build",
    "dev": "eve dev",
    "eve:info": "eve info --json",
    "migration:check": "bun run scripts/check-memory-migration.ts",
    "replay:pr61": "bun run scripts/replay-review.ts",
    "start": "eve start",
    "test": "bun test",
    "test:e2e:mock": "cd tests/fixtures/eve-runtime-smoke && bun x eve eval --strict --skip-report",
    "typecheck": "tsc --noEmit && tsc -p convex/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-browser/eve": "0.37.1",
    "@ai-sdk/gateway": "4.0.78",
    "@chat-adapter/github": "4.40.0",
    "@convex-dev/rag": "0.7.6",
    "@octokit/rest": "22.0.1",
    "@opentelemetry/api": "1.9.1",
    "@vercel/connect": "2.0.4",
    "@vercel/sandbox": "3.2.2",
    "ai": "7.0.97",
    "chat": "4.40.0",
    "convex": "1.45.0",
    "eve": "0.52.5",
    "js-tiktoken": "1.0.21",
    "semver": "7.8.5",
    "yaml": "2.9.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "24.13.4",
    "@types/semver": "7.8.0",
    "convex-test": "0.0.57",
    "just-bash": "3.4.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ai": "7.0.97"
  },
  "engines": {
    "node": "24.x"
  }
}
